# Captured artefacts are regenerable from `fisdraft.capture` in ~51 s and the
# log-prob dump alone is ~2 GB. The JSON result files are small and ARE tracked,
# so a table can always be traced to the run that produced it.
.venv/
runs/**/*.npy
runs/**/*.parquet
__pycache__/
# Capture/install/run logs and regenerable plots. The JSON result files above
# stay tracked on purpose; these logs (e.g. bnb_install.log, dl*.log) and plots
# (clamp_scale.png via plot_clamp_scale.py) regenerate from the run scripts.
runs/**/*.log
runs/**/*.png
