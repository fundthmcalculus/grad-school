# Generated experiment outputs (CSVs, plots, caches) -- always write these to
# an outputs/ subfolder rather than an experiment's top level, so scripts stay
# easy to find and PR diffs don't fill up with regenerable artifacts. Anything
# genuinely worth committing (a report, a plot too expensive to regenerate on
# demand) should be force-added (`git add -f`) rather than moved out of here.
outputs/

# Large datasets from public sources (Kaggle, UCI ML, figshare) -- downloaded,
# never tracked. Document each in data/README.md with source, size, and description.
# Results and reports derived from them belong under outputs/ or a report .md,
# force-added if worth keeping.
/data/nasa-cmapps2/
/data/RT_IOT2022.csv
/data/WEC_Perth_49.csv
/data/WEC_Perth_100.csv
/data/WEC_Sydney_49.csv

# Figures the AnalyticalDynamics simulations regenerate on every run. None has
# ever been tracked; the chapter figures live under research/ instead.
/AnalyticalDynamics/*.png
/AnalyticalDynamics/*.gif

# Python bytecode
__pycache__/
*.py[cod]

# Editor swap / backup files. A Vim swapfile was committed once (57dc1a4) by an
# auto-staging hook while a doc was open; these keep that from recurring.
*.swp
*.swo
*~
*.orig
*.rej

# IDE
.idea/

.twocart_train.npz

# LaTeX build artifacts
*.aux
*.toc
*.out
*.synctex.gz

# Local venvs
.venv*/

# Cython build artifacts (ode_kernels): generated C, compiled extensions,
# annotation HTML, and the build/ scratch tree are all reproducible via
# `python ode_kernels/setup.py build_ext --inplace`.
ode_kernels/build/
ode_kernels/*.c
ode_kernels/*.so
ode_kernels/*.html
.pytest_cache/

# Proposal figures are regenerated by research/proposal-defense/make_placeholder_figures.py
# (and the reproduce/figures registry). The prose embeds the .png copies; the .eps
# copies are never referenced, so they are regenerable and not tracked.
/research/proposal-defense/prose/fig/*.eps

# TSPLIB benchmark instances (standard, publicly published). Fetch them with
# `python ClusteringExperiments/tsplib/download.py`. The optimum index
# (solutions, xray.problems) and README stay tracked; the .tsp files do not.
/ClusteringExperiments/tsplib/*.tsp
