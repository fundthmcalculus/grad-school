# N-CMAPSS dataset (28GB across 10 .h5 files) -- downloaded from Kaggle, never
# tracked. Only FuzzySystemsExperiments/cmapss_rul*.py and their result
# CSVs/plots are meant to be committed.
/NASA-CMAPSS/*.h5
/NASA-CMAPSS/*.crdownload

# cmapss_rul.py's own resume checkpoint (pickled agg_cache) -- regenerated
# from the .h5 file above on every fresh run, not meant to be tracked.
/FuzzySystemsExperiments/.cmapss_rul_cache.pkl

# Figures the AnalyticalDynamics simulations regenerate on every run. None has
# ever been tracked; the chapter figures live under research/ instead.
/AnalyticalDynamics/*.png
/AnalyticalDynamics/*.gif

# Python bytecode
__pycache__/
*.py[cod]

# Editor swap / backup files. A Vim swapfile was committed once (57dc1a4) by an
# auto-staging hook while a doc was open; these keep that from recurring.
*.swp
*.swo
*~
*.orig
*.rej

# IDE
.idea/

# Local venvs
.venv*/

# Cython build artifacts (ode_kernels): generated C, compiled extensions,
# annotation HTML, and the build/ scratch tree are all reproducible via
# `python ode_kernels/setup.py build_ext --inplace`.
ode_kernels/build/
ode_kernels/*.c
ode_kernels/*.so
ode_kernels/*.html
.pytest_cache/
